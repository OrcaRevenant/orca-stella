{
  "openapi": "3.0.0",
  "info": {
    "title": "Portfolio Transactions API",
    "version": "1.0.0",
    "description": "An API to get transaction information for portfolios."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Portfolio Transactions Server"
    }
  ],
  "paths": {
    "/aggregation/{portfolio_id}/transactions": {
      "get": {
        "summary": "Get portfolio transactions",
        "operationId": "getPortfolioTransactions",
        "description": "Retrieves transaction history for a specified portfolio.",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "description": "The ID of the portfolio to retrieve transactions for",
            "required": true,
            "schema": {
              "type": "string",
              "example": "portfolio_123"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number for pagination",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "example": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Number of transactions per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "example": 10
            }
          },
          {
            "name": "order",
            "in": "query",
            "description": "Sort order for transactions",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc",
              "example": "desc"
            }
          },
          {
            "name": "type",
            "in": "query",
            "description": "Type of transactions to retrieve",
            "required": false,
            "schema": {
              "type": "string",
              "default": "portfolio",
              "example": "portfolio"
            }
          },
          {
            "name": "quote",
            "in": "query",
            "description": "Quote currency for transaction values",
            "required": false,
            "schema": {
              "type": "string",
              "default": "usdt",
              "example": "usdt"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Transactions retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "list": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Transaction ID"
                          },
                          "hash": {
                            "type": "string",
                            "description": "Transaction hash"
                          },
                          "portfolio": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "title": {
                                "type": "string"
                              },
                              "connection": {
                                "type": "object",
                                "properties": {
                                  "logo": {
                                    "type": "string"
                                  },
                                  "name": {
                                    "type": "string"
                                  },
                                  "title": {
                                    "type": "string"
                                  },
                                  "type": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          },
                          "asset": {
                            "type": "object",
                            "properties": {
                              "logo": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "symbol": {
                                "type": "string"
                              }
                            }
                          },
                          "amount": {
                            "type": "number",
                            "description": "Transaction amount"
                          },
                          "time": {
                            "type": "string",
                            "format": "date-time",
                            "description": "Transaction timestamp"
                          },
                          "type": {
                            "type": "string",
                            "enum": ["buy", "sell", "deposit", "withdrawal"],
                            "description": "Transaction type"
                          },
                          "value": {
                            "type": "number",
                            "description": "Transaction value in quote currency"
                          },
                          "portfolio_total_value": {
                            "type": "number",
                            "description": "Portfolio total value after transaction"
                          },
                          "pnl": {
                            "type": "number",
                            "description": "Profit and loss"
                          },
                          "pnl_percentage": {
                            "type": "number",
                            "description": "Profit and loss percentage"
                          }
                        }
                      }
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "page": {
                          "type": "integer"
                        },
                        "limit": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        },
                        "pageCount": {
                          "type": "integer"
                        },
                        "hasPreviousPage": {
                          "type": "boolean"
                        },
                        "hasNextPage": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing token"
          },
          "404": {
            "description": "Portfolio not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
